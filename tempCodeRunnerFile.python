import tensorflow as tf
import os

print("=== TensorFlow GPU Diagnosis ===")
print(f"TensorFlow version: {tf.__version__}")
print(f"Built with CUDA: {tf.test.is_built_with_cuda()}")

# Check if GPU is available (old method)
print(f"GPU available (deprecated): {tf.test.is_gpu_available()}")

# Check physical devices
physical_gpus = tf.config.list_physical_devices('GPU')
print(f"Physical GPUs detected: {len(physical_gpus)}")

# Check logical devices  
logical_gpus = tf.config.list_logical_devices('GPU')
print(f"Logical GPUs available: {len(logical_gpus)}")

if physical_gpus:
    print("GPU Details:")
    for i, gpu in enumerate(physical_gpus):
        print(f"  GPU {i}: {gpu}")
        
    # Try to get GPU memory info
    try:
        gpu_details = tf.config.experimental.get_device_details(physical_gpus[0])
        print(f"GPU compute capability: {gpu_details.get('compute_capability', 'Unknown')}")
    except Exception as e:
        print(f"Could not get GPU details: {e}")
else:
    print("No GPUs detected!")

# Test actual GPU computation
print("\n=== Testing GPU Computation ===")
try:
    with tf.device('/GPU:0'):
        a = tf.constant([[1.0, 2.0], [3.0, 4.0]])
        b = tf.constant([[5.0, 6.0], [7.0, 8.0]])
        c = tf.matmul(a, b)
        print("✅ GPU computation successful!")
        print(f"Result: {c.numpy()}")
except Exception as e:
    print(f"❌ GPU computation failed: {e}")

# Check CUDA/cuDNN versions TensorFlow was built with
print("\n=== CUDA/cuDNN Build Info ===")
print(f"CUDA build version: {tf.sysconfig.get_build_info().get('cuda_version', 'Not found')}")
print(f"cuDNN build version: {tf.sysconfig.get_build_info().get('cudnn_version', 'Not found')}")